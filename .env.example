# Exposées au navigateur (build Astro) — utilisées par Supabase Auth côté client
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — utilisées par les Cloudflare Pages Functions (functions/api/*)
# À définir dans Cloudflare Pages → Settings → Environment variables
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...
# Optionnel — un mock réaliste est utilisé si absent
BRVM_API_KEY=
