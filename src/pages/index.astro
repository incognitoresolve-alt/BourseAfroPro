---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accueil">
  <div class="max-w-5xl mx-auto px-4 py-24 text-center">
    <span class="badge-green mb-6 inline-flex">BRVM · NSE · JSE</span>
    <h1 class="text-4xl sm:text-5xl font-bold mb-6">
      Apprenez à investir sur les <span class="text-brand-400">marchés boursiers africains</span>
    </h1>
    <p class="text-gray-400 text-lg mb-10 max-w-2xl mx-auto">
      Modules pédagogiques, quiz et simulateur de trading avec 10 000 000 FCFA virtuels.
      Progressez à votre rythme, sans risque.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/academy" class="btn-primary">Commencer l'Academy</a>
      <a href="/simulateur" class="btn-secondary">Essayer le simulateur</a>
    </div>
  </div>
</BaseLayout>
