---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mon Espace">
  <div class="max-w-4xl mx-auto px-4 py-16" id="profil-app">
    <!-- État non connecté (par défaut) -->
    <div id="logged-out" class="max-w-sm mx-auto text-center py-20">
      <h1 class="text-2xl font-bold mb-4">Mon Espace</h1>
      <p class="text-gray-400 mb-8">Connectez-vous pour suivre votre progression et accéder à votre portefeuille virtuel.</p>

      <form id="login-form" class="space-y-3">
        <input
          type="email"
          id="login-email"
          required
          placeholder="vous@exemple.com"
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:border-brand-500 outline-none"
        />
        <button type="submit" class="btn-primary w-full justify-center">
          Recevoir un lien de connexion
        </button>
      </form>
      <p id="login-message" class="text-sm text-brand-400 mt-4 hidden"></p>
    </div>

    <!-- État connecté (affiché via JS après auth) -->
    <div id="logged-in" class="hidden">
      <div class="flex items-center gap-4 mb-10">
        <div class="w-14 h-14 rounded-full bg-brand-500/20 flex items-center justify-center text-2xl">👤</div>
        <div>
          <h1 class="text-xl font-bold" id="user-name">Investisseur</h1>
          <p class="text-gray-400 text-sm" id="user-email"></p>
        </div>
        <button id="logout-btn" class="ml-auto btn-secondary text-sm py-2">Déconnexion</button>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 mb-10">
        <div class="card text-center">
          <p class="text-2xl font-bold text-gold-400">0</p>
          <p class="text-gray-400 text-sm mt-1">XP Total</p>
        </div>
        <div class="card text-center">
          <p class="text-2xl font-bold text-brand-400">0/23</p>
          <p class="text-gray-400 text-sm mt-1">Modules complétés</p>
        </div>
        <div class="card text-center">
          <p class="text-2xl font-bold text-white">0</p>
          <p class="text-gray-400 text-sm mt-1">Badges obtenus</p>
        </div>
      </div>

      <div class="card">
        <h2 class="font-semibold mb-4">Progression</h2>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between text-sm mb-1">
              <span class="text-gray-300">Niveau 1 — Initiation</span>
              <span class="text-gray-500">0 / 5 modules</span>
            </div>
            <div class="h-2 bg-gray-800 rounded-full">
              <div class="h-2 bg-brand-500 rounded-full w-0 transition-all duration-500"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/db';

    function showLoggedOut() {
      document.getElementById('logged-out')?.classList.remove('hidden');
      document.getElementById('logged-in')?.classList.add('hidden');
    }

    function showLoggedIn(email: string) {
      document.getElementById('logged-out')?.classList.add('hidden');
      document.getElementById('logged-in')?.classList.remove('hidden');
      const emailEl = document.getElementById('user-email');
      if (emailEl) emailEl.textContent = email;
    }

    // État initial + mises à jour (connexion via lien magique, déconnexion, etc.)
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session?.user.email) showLoggedIn(session.user.email);
    });

    supabase.auth.onAuthStateChange((_event, session) => {
      if (session?.user.email) {
        showLoggedIn(session.user.email);
      } else {
        showLoggedOut();
      }
    });

    document.getElementById('login-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('login-email') as HTMLInputElement;
      const messageEl = document.getElementById('login-message');
      const email = emailInput.value.trim();
      if (!email) return;

      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: window.location.origin + '/profil' },
      });

      if (messageEl) {
        messageEl.textContent = error
          ? "Erreur d'envoi — réessayez dans quelques instants."
          : `Lien de connexion envoyé à ${email}. Vérifiez votre boîte mail.`;
        messageEl.classList.remove('hidden');
      }
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      showLoggedOut();
    });
  </script>
</BaseLayout>
